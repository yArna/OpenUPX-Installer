{
  "name": "openuxp-installer",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://github.com/yArna/OpenUPX-Installer",
  "repository": {
    "type": "git",
    "url": "https://github.com/yArna/OpenUPX-Installer.git"
  },
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "dev": "npm run version:sync && tauri dev",
    "dev:web": "vite",
    "build": "npm run version:sync && tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "build:web": "vite build",
    "check": "tsc --noEmit",
    "release": "bash scripts/release-all.sh",
    "release:macos": "bash scripts/release-macos.sh",
    "release:windows": "bash scripts/release-windows.sh",
    "release:github": "bash scripts/release-macos.sh --publish-existing",
    "release:macos:github": "bash scripts/release-macos.sh --publish-existing",
    "release:macos:github:build": "bash scripts/release-macos.sh --publish"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~5.6.3",
    "vite": "^8.1.5"
  }
}
